rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'muzammilahmad8785@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function to check if owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products: public read and write for real-time admin management & persistence
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories: public read and write
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Deals: public read and write
    match /deals/{dealId} {
      allow read, write: if true;
    }

    // Homepage banners: public read and write
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Homepage offers media carousel: public read and write
    match /homepageOffers/{offerId} {
      allow read, write: if true;
    }

    // Media library: public read and write
    match /media/{mediaId} {
      allow read, write: if true;
    }

    // Restaurant settings & hero config: public read and write
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Branches: public read and write
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // Users collection: read and write
    match /users/{userId} {
      allow read, write: if true;
    }

    // Orders collection: read and write for customer placing and admin management
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
